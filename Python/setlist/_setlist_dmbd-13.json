    {
      "name": "フェアリー・ライフ",
      "pic": [
        "https://dm.takaratomy.co.jp/wp-content/card/cardimage/dmbd13-023.jpg",
        "https://dm.takaratomy.co.jp/wp-content/card/cardimage/dmbd13-024.jpg",
